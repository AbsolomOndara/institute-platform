generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  COMPLETED
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String
  email              String               @unique
  passwordHash       String?
  role               UserRole             @default(STUDENT)
  status             UserStatus           @default(ACTIVE)
  mustChangePassword Boolean              @default(false)
  tutorProfile       TutorProfile?
  taughtCourses      CourseTutor[]
  enrollments        Enrollment[]         @relation("StudentEnrollments")
  approvals          Enrollment[]         @relation("EnrollmentApprover")
  progress           LessonProgress[]
  passwordTokens     PasswordSetupToken[]
  contactReplies     ContactMessage[]     @relation("ContactResponder")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model TutorProfile {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  bio       String?
  expertise String?
  photoUrl  String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id           Int           @id @default(autoincrement())
  title        String
  description  String
  price        Decimal       @default(0)
  imageUrl     String?
  duration     String?
  level        String?
  deliveryMode String        @default("Online and in-person")
  featured     Boolean       @default(false)
  status       CourseStatus  @default(DRAFT)
  tutors       CourseTutor[]
  modules      Module[]
  enrollments  Enrollment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model CourseTutor {
  courseId   Int
  tutorId    Int
  assignedAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutor      User     @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@id([courseId, tutorId])
}

model Module {
  id       Int      @id @default(autoincrement())
  courseId Int
  title    String
  position Int
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([courseId, position])
}

model Lesson {
  id          Int              @id @default(autoincrement())
  moduleId    Int
  title       String
  content     String?
  videoUrl    String?
  resourceUrl String?
  position    Int
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@unique([moduleId, position])
}

model Enrollment {
  id              Int              @id @default(autoincrement())
  studentId       Int
  courseId        Int
  status          EnrollmentStatus @default(PENDING)
  requestedAt     DateTime         @default(now())
  approvedAt      DateTime?
  approvedById    Int?
  rejectedAt      DateTime?
  rejectionReason String?
  updatedAt       DateTime         @updatedAt
  student         User             @relation("StudentEnrollments", fields: [studentId], references: [id])
  course          Course           @relation(fields: [courseId], references: [id])
  approvedBy      User?            @relation("EnrollmentApprover", fields: [approvedById], references: [id])

  @@unique([studentId, courseId])
}

model LessonProgress {
  studentId   Int
  lessonId    Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([studentId, lessonId])
}

model PasswordSetupToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id            Int       @id @default(autoincrement())
  name          String
  email         String
  phone         String?
  subject       String?
  message       String
  status        String    @default("NEW")
  respondedAt   DateTime?
  respondedById Int?
  respondedBy   User?     @relation("ContactResponder", fields: [respondedById], references: [id])
  createdAt     DateTime  @default(now())
}
